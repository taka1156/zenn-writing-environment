{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode/main/extensions/configuration-editing/schemas/devContainer.vscode.schema.json",
  "name": "zenn-writing-environment",
  "service": "study_room",
  "workspaceFolder": "/workspace",
  "dockerComposeFile": "docker-compose.yaml",
  "containerEnv": {
    "AUTOSAVE_INTERVAL": "300",
    "AUTOSAVE_EXCLUDE_FILE": ".devcontainer/autosave.ignore"
  },
  "postStartCommand": "yarn install && nohup bash .devcontainer/autosave.sh \"$PWD\" >/tmp/autosave.log 2>&1",
  "customizations": {
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "on",
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "github.copilot.enable": {
          "*": false
        },
        "chat.disableAIFeatures": false,
        "[markdown]": {
          "editor.quickSuggestions": {
            "other": "on",
            "comments": "off",
            "strings": "off"
          }
        }
      },
      "extensions": [
        "MS-CEINTL.vscode-language-pack-ja",
        "streetsidesoftware.code-spell-checker",
        "username.errorlens",
        "davidanson.vscode-markdownlint",
        "yzhang.markdown-all-in-one",
        "zenn.zenn-preview",
      ]
    }
  }
}